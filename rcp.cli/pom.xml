<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<artifactId>rcp.cli</artifactId>
	<packaging>jar</packaging>

	<parent>
		<groupId>dev.tim9h</groupId>
		<artifactId>rcp.parent</artifactId>
		<version>1.1.0-SNAPSHOT</version>
	</parent>

	<dependencies>

		<dependency>
			<groupId>dev.tim9h</groupId>
			<artifactId>rcp.api</artifactId>
		</dependency>

		<dependency>
			<groupId>dev.tim9h</groupId>
			<artifactId>rcp.controls</artifactId>
		</dependency>

		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
		</dependency>

		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>

		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>2.14.0</version>
		</dependency>

		<dependency>
			<groupId>com.fathzer</groupId>
			<artifactId>javaluator</artifactId>
			<version>3.0.9</version>
		</dependency>

		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-text</artifactId>
			<version>1.15.0</version>
		</dependency>

	</dependencies>

	<build>

		<resources>

			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>**/*.scss</exclude>
				</excludes>
			</resource>

		</resources>

		<plugins>

			<plugin>
				<groupId>io.github.cleydyr</groupId>
				<artifactId>dart-sass-maven-plugin</artifactId>
				<configuration>
					<version>1.83.0</version>
					<inputFolder>${basedir}/src/main/resources/sass</inputFolder>
					<outputFolder>${basedir}/src/main/resources/css</outputFolder>
				</configuration>
				<executions>
					<execution>
						<id>generate-css-using-sass</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>compile-sass</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<configuration>
					<createDependencyReducedPom>false</createDependencyReducedPom>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<artifactSet>
								<includes>
									<include>com.google.code.gson:gson</include>
									<include>com.fathzer:javaluator</include>
									<include>org.apache.commons:commons-text</include>
								</includes>
							</artifactSet>
						</configuration>
					</execution>
				</executions>
			</plugin>

		</plugins>

	</build>

	<profiles>
		<profile>
			<id>windows-app-image</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>3.2.0</version>
						<executions>
							<execution>
								<id>create-windows-app-image</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<property name="image.dir" location="${project.basedir}/../rcp.core/target/RCP" />
										<property name="input.dir" location="${project.build.directory}/jpackage-input" />
										<delete dir="${input.dir}" />
										<mkdir dir="${input.dir}" />
										<copy file="${project.basedir}/../rcp.core/target/rcp.core-${project.version}.jar"
											todir="${input.dir}" />
										<delete dir="${project.basedir}/../rcp.core/target/plugins" />
										<delete dir="${image.dir}" />
										<exec executable="${java.home}/bin/jpackage.exe" failonerror="true"
											dir="${project.build.directory}">
											<arg value="--type" />
											<arg value="app-image" />
											<arg value="--name" />
											<arg value="RCP" />
											<arg value="--icon" />
											<arg value="${project.basedir}/../rcp.core/src/main/resources/icon.ico" />
											<arg value="--input" />
											<arg value="${input.dir}" />
											<arg value="--dest" />
											<arg value="${project.basedir}/../rcp.core/target" />
											<arg value="--main-jar" />
											<arg value="rcp.core-${project.version}.jar" />
											<arg value="--main-class" />
											<arg value="dev.tim9h.rcp.core.Main" />
											<arg value="--java-options" />
											<arg value="-Dlogpath=C:\temp" />
											<arg value="--java-options" />
											<arg value="--enable-native-access=rcp.core" />
											<arg value="--java-options" />
											<arg value="--enable-native-access=com.sun.jna" />
											<arg value="--java-options" />
											<arg value="--enable-native-access=javafx.graphics" />
											<arg value="--java-options" />
											<arg value="--enable-native-access=ALL-UNNAMED" />
											<arg value="--java-options" />
											<arg value="--enable-native-access=dev.tim9h.javafxblur2" />
											<arg value="--java-options" />
											<arg value="--enable-native-access=javafx.media" />
										</exec>
										<mkdir dir="${image.dir}/plugins" />
										<copy file="${project.build.directory}/${project.build.finalName}.jar"
											todir="${image.dir}/plugins" />
										<echo file="${image.dir}/plugins/README.txt">Place plugin JAR files in this directory.</echo>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>